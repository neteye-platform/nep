    $self->get_snmp_tables('USAGE-MIB', [
        ['cpus', 'deviceUsageTable', 'CheckNwcHealth::AVOS::Component::CpuSubsystem::DevCpu', sub { return shift->{deviceUsageName} =~ /CPU/ }],
