        $self->{clusterConcurrentUsers},
        $self->{iveConcurrentUsers},
        $self->{signedInWebUsers},
        $self->{signedInMailUsers},
        $self->{iveVPNTunnels},
        $self->{iveSSLConnections}
    );
    $self->set_thresholds(metric => "concurrent_users",
