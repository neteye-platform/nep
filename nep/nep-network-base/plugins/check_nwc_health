sub sort_oids {
  my ($self, $oids) = @_;
  $oids ||= [];
  my @sortedkeys = map { $_->[0] }
      sort { $a->[1] cmp $b->[1] }
          map { [$_,
                  join '', map { sprintf("%30d",$_) } split( /\./, $_)
                ] } @{$oids};
  return @sortedkeys;
}

sub sort_indices {
  my ($self, $indices) = @_;
  my @sortedindices = map { $_->[0] }
      sort { $a->[1] cmp $b->[1] }
          map { [$_,
              join '', map { sprintf("%30d",$_) } split( /\./, $_)
          ] } map { join('.', @{$_})} @{$indices};
  return @sortedindices;
}


