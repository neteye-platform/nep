  my ($self) = @_;
  if ($self->{temperatureReading} == 0 ||
      $self->{temperatureReading} == 2147483647) {
    $self->{valid} = 0;
  } else {
    $self->{valid} = 1;
    my $factor = $self->{temperatureResolution} * 1 / (10 * 10);
    $self->{temperatureReading} *= $factor;
  }
  $self->{valid} = 0 if $self->{temperatureStatus} eq "unavailable";
}

