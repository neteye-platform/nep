sub init {
  my ($self) = @_;
  $self->get_snmp_objects('PAN-COMMON-MIB', (qw(
      panSysHAMode panSysHAState panSysHAPeerState)));
  if ($self->mode =~ /device::ha::role/ && ! $self->opts->role()) {
