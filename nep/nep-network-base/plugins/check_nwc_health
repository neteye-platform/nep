  # INDEX { bgpRmEntIndex,            # Unsigned32
  #         bgpPeerLocalAddrType,     # InetAddressType
  #         bgpPeerLocalAddr,         # InetAddress
  #         bgpPeerLocalPort,         # InetPortNumber
