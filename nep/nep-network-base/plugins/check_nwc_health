  return if ! $self->{valid};
  foreach (qw(ciscoSlaNextCertificateExpireTime ciscoSlaRegisterInitTime ciscoSlaRenewNextRetryTime)) {
    $self->{$_."Human"} = scalar localtime $self->{$_}
        if exists $self->{$_} and $self->{$_} =~ /^\d+$/;
  }
