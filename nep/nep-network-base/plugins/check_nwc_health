    my $octetnumber = 0;
    foreach my $octet (@octets) {
      # octet represents ports $octetnumber*8+(1..8)
      my $index = 1;
      while ($octet) {
        next unless $octet & 0x80;
        push(@ports, $octetnumber * 8 + $index);
      } continue {
        ++$index;
        $octet = ($octet << 1) & 0xff;
      }
    } continue {
      ++$octetnumber;
    }
    @ports = do { my %seen; map { $seen{$_}++ ? () : $_ } @ports };
    return \@ports;
