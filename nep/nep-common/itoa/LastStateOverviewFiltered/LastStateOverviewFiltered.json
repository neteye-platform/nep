      "targets": [
        {
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n    FROM_UNIXTIME(sh.event_time / 1000) AS `State time`,\n    'Host' AS `Object type`,\n    h.name AS `Object name`,\n    h.name AS `Hostname`,\n    CASE\n        WHEN sh.state_type = 'hard' AND sh.hard_state = 0 THEN 'Host UP'\n        WHEN sh.state_type = 'soft' AND sh.soft_state = 0 THEN 'Host UP'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) IN (1, 2, 3)\n            THEN 'Host DOWN'\n        ELSE 'Host N/A'\n    END AS `State`,\n    CASE\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 0 THEN '10'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 1 THEN '11'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 2 THEN '12'\n        ELSE 'Host N/A'\n    END AS `StateCode`,\n    IF(sh.state_type = 'soft', 'Soft', 'Hard') AS `State type`,\n    IF(sh.state_type = 'soft', '30', '31') AS `StateTypeCode`,\n    CONCAT(sh.check_attempt, '/', sh.max_check_attempts) AS `Check attempt`,\n    IF(CHAR_LENGTH(sh.output) > 50,\n       CONCAT(LEFT(sh.output, 50), '    (...)'), sh.output) AS `Plugin Output`,\n    sh.check_source AS `Check source`\nFROM icingadb.state_history sh\nJOIN icingadb.host h ON h.id = sh.host_id\nWHERE sh.environment_id = UNHEX('3436AFE81C0CE1CF5BAB25E0EF1E353160637F61') AND sh.environment_id = h.environment_id\n  AND sh.object_type = 'host'\n  AND sh.event_time BETWEEN ($__unixEpochFrom() * 1000)\n                        AND ($__unixEpochTo() * 1000)\n  AND (\n    CASE\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 0 THEN 'Host UP'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) IN (1, 2, 3)\n            THEN 'Host DOWN'\n        ELSE 'Host N/A'\n    END\n  ) IN (${state:sqlstring})\n\nUNION ALL\n\nSELECT\n    FROM_UNIXTIME(sh.event_time / 1000) AS `State time`,\n    'Service' AS `Object type`,\n    CONCAT(h.name, ' __ ', s.name) AS `Object name`,\n    h.name AS `Hostname`,\n    CASE\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 0 THEN 'Service OK'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 1 THEN 'Service WARNING'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 2 THEN 'Service CRITICAL'\n        WHEN (CASE WHEN sh.state_type = 'hard'\n                   THEN sh.hard_state ELSE sh.soft_state END) = 3 THEN 'Service UNKNOWN'\n        ELSE 'Service N/A'\n    END AS `State`,\n    CASE (CASE WHEN sh.state_type = 'hard'\n               THEN sh.hard_state ELSE sh.soft_state END)\n        WHEN 0 THEN '20'\n        WHEN 1 THEN '21'\n        WHEN 2 THEN '22'\n        WHEN 3 THEN '23'\n        ELSE 'Service N/A'\n    END AS `StateCode`,\n    IF(sh.state_type = 'soft', 'Soft', 'Hard') AS `State type`,\n    IF(sh.state_type = 'soft', '30', '31') AS `StateTypeCode`,\n    CONCAT(sh.check_attempt, '/', sh.max_check_attempts) AS `Check attempt`,\n    IF(CHAR_LENGTH(sh.output) > 50,\n       CONCAT(LEFT(sh.output, 50), '    (...)'), sh.output) AS `Plugin Output`,\n    sh.check_source AS `Check source`\nFROM icingadb.state_history sh\nJOIN icingadb.service s ON s.id = sh.service_id\nJOIN icingadb.host h ON h.id = s.host_id\nWHERE sh.environment_id = UNHEX('3436AFE81C0CE1CF5BAB25E0EF1E353160637F61') AND sh.environment_id = s.environment_id\n  AND sh.environment_id = h.environment_id\n  AND sh.object_type = 'service'\n  AND sh.event_time BETWEEN ($__unixEpochFrom() * 1000)\n                        AND ($__unixEpochTo() * 1000)\n  AND (\n    CASE (CASE WHEN sh.state_type = 'hard'\n               THEN sh.hard_state ELSE sh.soft_state END)\n        WHEN 0 THEN 'Service OK'\n        WHEN 1 THEN 'Service WARNING'\n        WHEN 2 THEN 'Service CRITICAL'\n        WHEN 3 THEN 'Service UNKNOWN'\n        ELSE 'Service N/A'\n    END\n  ) IN (${state:sqlstring})\n  AND IF(sh.state_type = 'soft', 'Soft', 'Hard')\n      IN (${state_types:sqlstring})",
          "refId": "A",
