      "targets": [
        {
          "datasource": {
            "uid": "icingadb-mysql"
          },
          "format": "table",
          "group": [],
          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n   h.name AS host_name,\n   h.address AS host_address,\n   s.name AS service_description,\n   ss.soft_state AS service_state,\n   IF(ss.last_state_change = 0, NULL, TIMESTAMPADD(SECOND, ss.last_state_change DIV 1000, '1970-01-01 00:00:00')) AS 'State time',\n   IF(ss.last_state_change = 0, 'n/a', CONCAT(\n      (GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(ss.last_state_change AS SIGNED), 0) DIV 86400000), ' d ',\n      MOD((GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(ss.last_state_change AS SIGNED), 0) DIV 3600000), 24), ' h ',\n      MOD((GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(ss.last_state_change AS SIGNED), 0) DIV 60000), 60), ' m '\n   )) AS duration,\n   IF(LENGTH(ss.output) > 80, CONCAT(LEFT(ss.output, 80), '    (...)'), ss.output) AS service_output,\n   IF(ss.is_acknowledged='n', 'Not acknowledged', 'Acknowledged') AS service_acknowledged,\n   IF(ss.in_downtime='n', 'Not in Downtime', 'In Downtime') AS service_in_downtime,\n   IF(ss.is_handled='y', 'Handled', 'Not handled') AS 'Handled'\nFROM\n   service s\n   INNER JOIN host h ON h.id = s.host_id\n   INNER JOIN host_state hs ON hs.host_id = h.id\n   INNER JOIN service_state ss ON ss.service_id = s.id\nWHERE\n   ss.soft_state IN ($service_state)\n   AND\n   CASE\n      WHEN '${problem_handled}' = 'Handled' THEN\n         ss.is_handled = 'y'\n      WHEN '${problem_handled}' = 'Not Handled' THEN\n         ss.is_handled = 'n'\n      WHEN '${problem_handled}' = 'All' THEN\n         TRUE\n   END\nAND NOT EXISTS (\n   SELECT 1\n   FROM service_customvar sc\n   INNER JOIN customvar cv_infra ON cv_infra.id = sc.customvar_id\n   WHERE sc.service_id = s.id\n     AND cv_infra.name = 'nx_is_infrastructural'\n     AND cv_infra.value = '\"y\"'\n)\nORDER BY ss.last_state_change DESC\n",
          "refId": "A",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "column"
              }
            ]
          ],
          "timeColumn": "time",
          "where": [
            {
              "name": "$__timeFilter",
              "params": [],
              "type": "macro"
            }
          ]
        }
