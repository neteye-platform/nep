          "rawQuery": true,
          "rawSql": "SELECT\n   h.name AS host_name,\n   h.address AS 'ip address',\n   hs.soft_state AS 'host_state',\n   IF(hs.last_state_change = 0, NULL, TIMESTAMPADD(SECOND, hs.last_state_change DIV 1000, '1970-01-01 00:00:00')) AS host_last_state_change,\n   IF(hs.last_state_change = 0, 'n/a', CONCAT(\n      (GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(hs.last_state_change AS SIGNED), 0) DIV 86400000), ' d ',\n      MOD((GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(hs.last_state_change AS SIGNED), 0) DIV 3600000), 24), ' h ',\n      MOD((GREATEST(CAST(UNIX_TIMESTAMP()*1000 AS SIGNED) - CAST(hs.last_state_change AS SIGNED), 0) DIV 60000), 60), ' m '\n   )) AS duration,\n   hs.output AS 'output',\n   IF(hs.is_acknowledged='n', 'Not acknowledged', 'Acknowledged') AS 'acknowledged',\n   IF(hs.in_downtime='n', 'Not in Downtime', 'In Downtime') AS 'in downtime',\n   IF(hs.is_handled='y', 'Handled', 'Not handled') AS 'Handled'\nFROM\n   host_state hs\n   INNER JOIN host h ON h.id = hs.host_id\nWHERE\n   CASE\n      WHEN '${problem_handled}' = 'Handled' THEN\n         hs.is_handled = 'y'\n      WHEN '${problem_handled}' = 'Not Handled' THEN\n         hs.is_handled = 'n'\n      WHEN '${problem_handled}' = 'All' THEN\n         TRUE\n   END\n   AND hs.soft_state > 0\n",
