          "metricColumn": "none",
          "rawQuery": true,
          "rawSql": "SELECT\n   (FLOOR(sh.event_time / $__interval_ms) * $__interval_ms) DIV 1000 AS time,\n   CASE sh.soft_state\n      WHEN 0 THEN IF(sh.object_type='host', 'Host to UP',   'Service to OK')\n      WHEN 1 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to WARNING')\n      WHEN 2 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to CRITICAL')\n      WHEN 3 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to UNKNOWN')\n      ELSE IF(sh.object_type='host', 'Host to N/A', 'Service to N/A')\n   END AS metric,\n   COUNT(sh.soft_state) AS value\nFROM\n   state_history sh\nWHERE\n   sh.environment_id = (SELECT id FROM environment LIMIT 1)\n   AND sh.event_time BETWEEN $__unixEpochFrom() * 1000 AND $__unixEpochTo() * 1000\n   AND CASE sh.state_type WHEN 'soft' THEN 0 WHEN 'hard' THEN 1 END IN(${state_types})\n   AND (\n     CASE sh.soft_state\n      WHEN 0 THEN IF(sh.object_type='host', 'Host to UP',   'Service to OK')\n      WHEN 1 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to WARNING')\n      WHEN 2 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to CRITICAL')\n      WHEN 3 THEN IF(sh.object_type='host', 'Host to DOWN', 'Service to UNKNOWN')\n      ELSE IF(sh.object_type='host', 'Host to N/A', 'Service to N/A')\n   END\n    ) IN(${state_transitions})\nGROUP BY 1,2\nORDER BY 1\n",
          "refId": "Hosts transitions to UP",
          "select": [
