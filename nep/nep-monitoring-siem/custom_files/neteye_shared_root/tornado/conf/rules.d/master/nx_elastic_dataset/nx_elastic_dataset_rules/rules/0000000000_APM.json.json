{
  "name": "APM",
  "description": "",
  "continue": false,
  "active": true,
  "constraint": {
    "WHERE": {
      "type": "AND",
      "operators": [
        {
          "type": "equals",
          "first": "${event.payload.data.agent}",
          "second": "none"
        }
      ]
    },
    "WITH": {}
  },
  "actions": [
    {
      "id": "smart_monitoring_check_result",
      "payload": {
        "check_result": {
          "exit_status": "0",
          "performance_data": "'documents'=${event.payload.data.docs};;;0;",
          "plugin_output": "OK - ${event.payload.data.docs} events found on Elasticsearch\nTenant: ${event.payload.data.tenant}<br>Agent: apm_server"
        },
        "host": {
          "address": "127.0.0.1",
          "imports": [
            "nx-ht-passive",
            "nx-ht-status-dummy",
            "nx-ht-type-custom"
          ],
          "object_name": "${event.payload.data.hostname}",
          "vars": {
            "created_by": "tornado",
            "rulename": "root/master/nx_elastic_dataset/nx_elastic_dataset_rules",
            "nx_is_infrastructural": "y"
          }
        },
        "service": {
          "imports": [
            "nx-st-interval-24h",
            "nx-st-passive-with-autoreset"
          ],
          "object_name": "Elastic Ingest Status - apm.* (${event.payload.data.type})",
          "vars": {
            "created_by": "tornado",
            "dummy_state": "2",
            "dummy_text": "No document ingested on Elasticsearch in the last $service.check_interval$ seconds",
            "nx_neteye_tenant": "${event.payload.data.tenant}",
            "nx_on_host_down": "disable_check_on_down_hard",
            "rulename": "root/master/nx_elastic_dataset/nx_elastic_dataset_rules",
            "nx_is_infrastructural": "y"
          }
        }
      }
    }
  ]
}