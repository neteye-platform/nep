          "policy": "default",
          "query": "SELECT mean(\"value\") FROM \"$command\" WHERE (\"hostname\" =~ /^$hostname$/ AND \"service\" =~ /^$service$/ ) AND \"metric\" = 'traffic_out' AND value < 999999999 AND $timeFilter GROUP BY metric, time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series",
          "select": [
            [
              {
                "params": [
                  "value"
                ],
                "type": "field"
              },
              {
                "params": [],
                "type": "mean"
              }
            ]
          ],
          "tags": [
            {
              "key": "hostname",
