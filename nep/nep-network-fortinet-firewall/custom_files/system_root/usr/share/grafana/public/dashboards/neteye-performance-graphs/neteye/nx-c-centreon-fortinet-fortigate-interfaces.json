          "measurement": "check_iftraffic64",
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT mean(\"value\") FROM \"$command\" WHERE (\"hostname\" =~ /^$hostname$/ AND \"service\" =~ /^$service$/ ) AND \"metric\" = 'traffic_in' AND value < 999999999 AND $timeFilter GROUP BY metric, time($__interval) fill(none)",
