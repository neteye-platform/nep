            },
            {
              "condition": "AND",
              "key": "metric",
              "operator": "=",
              "value": "inBandwidth"
            }
          ]
        },
        {
          "alias": "[[tag_metric]]",
          "datasource": {
            "type": "influxdb"
          },
          "groupBy": [
            {
              "params": [
                "$__interval"
              ],
              "type": "time"
            },
            {
              "params": [
                "none"
              ],
              "type": "fill"
            }
          ],
          "measurement": "check_iftraffic64",
          "orderByTime": "ASC",
          "policy": "default",
          "query": "SELECT mean(\"value\") FROM \"$command\" WHERE (\"hostname\" =~ /^$hostname$/ AND \"service\" =~ /^$service$/ )  AND \"metric\" != 'traffic_in' AND \"metric\" != 'traffic_out' AND value < 999999999 AND $timeFilter GROUP BY metric, time($__interval) fill(none)",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "time_series",
          "select": [
            [
              {
                "params": [
