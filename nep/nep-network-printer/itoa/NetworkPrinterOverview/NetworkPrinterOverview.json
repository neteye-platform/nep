          "type": "influxdb",
          "uid": "${ds}"
        },
        "definition": "SHOW TAG VALUES FROM \"nx-c-check-printer-health\" WITH KEY = \"hostname\"",
        "query": "SHOW TAG VALUES FROM \"nx-c-check-printer-health\" WITH KEY = \"hostname\"",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
