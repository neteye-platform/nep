    {
      "type": "stat",
      "id": 8,
      "title": "Active problems",
      "description": "Services of the printer which are CRITICAL, WARNING or UNKNOWN now (current state in NetEye, datasource IcingaDB, independent of the time range). Open the printer in NetEye to see the problems.",
      "datasource": {
        "type": "mysql",
        "uid": "${dsicingadb}"
      },
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${dsicingadb}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  COALESCE(SUM(ss.soft_state = 2), 0) AS `Critical`,\n  COALESCE(SUM(ss.soft_state = 1), 0) AS `Warning`,\n  COALESCE(SUM(ss.soft_state = 3), 0) AS `Unknown`\nFROM host h\nJOIN service s ON s.host_id = h.id\nJOIN service_state ss ON ss.service_id = s.id\nWHERE h.name = ${hostname:sqlstring}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Critical"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
