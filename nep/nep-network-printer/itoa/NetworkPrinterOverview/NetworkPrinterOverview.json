  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "",
      "description": "Printer name and address from the NetEye Host, model and serial number from the service Printer Info (datasource IcingaDB). When the printer is not reachable, the last known model and serial number are shown.",
      "datasource": {
        "type": "mysql",
        "uid": "${dsicingadb}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 17,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${dsicingadb}"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  h.display_name AS `Printer`,\n  h.address AS `Address`,\n  IF(LOCATE(', Serial ', pi.output) > 0,\n     TRIM(SUBSTRING_INDEX(REGEXP_REPLACE(pi.output, '^[A-Z]+ - ', ''), ', Serial ', 1)), NULL) AS `Model`,\n  IF(LOCATE(', Serial ', pi.output) > 0,\n     TRIM(SUBSTRING(SUBSTRING_INDEX(pi.output, ', Serial ', -1), 2)), NULL) AS `Serial number`\nFROM host h\nLEFT JOIN (\n  SELECT s.host_id, COALESCE(\n      IF(LOCATE(', Serial ', ss.output) > 0, ss.output, NULL),\n      (SELECT sh.output FROM state_history sh\n       WHERE sh.service_id = s.id AND LOCATE(', Serial ', sh.output) > 0\n       ORDER BY sh.event_time DESC LIMIT 1)) AS output\n  FROM service s\n  JOIN service_customvar sc ON sc.service_id = s.id\n  JOIN customvar cv ON cv.id = sc.customvar_id\n  JOIN service_state ss ON ss.service_id = s.id\n  WHERE cv.name = 'nx_printer_health_mode' AND cv.value = '\"printer-info\"'\n) pi ON pi.host_id = h.id\nWHERE h.name = ${hostname:sqlstring}\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 24
        }
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "",
      "description": "Round trip time of the host check (ping) now: green below 50 ms, orange below 200 ms, red above, no reply when the printer does not answer (datasource InfluxDB).",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": true,
          "query": "SELECT last(\"value\") * 1000 FROM \"hostalive\" WHERE \"hostname\" = '$hostname' AND \"metric\" = 'rta' AND time > now() - 7d"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "hide": true,
          "query": "SELECT last(\"value\") FROM \"hostalive\" WHERE \"hostname\" = '$hostname' AND \"metric\" = 'pl' AND time > now() - 10m"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "C",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "D",
          "type": "reduce",
          "expression": "B",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "Ping",
          "type": "math",
          "expression": "($D < 100) * $C - ($D >= 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Ping",
          "unit": "ms",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "no reply",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 24
        }
      }
    },
